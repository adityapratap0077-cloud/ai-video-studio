# Copy this file to .env and fill in the values. Never commit .env.
# cp .env.example .env

# SQLite database file. Defaults to ./data/app.db (created automatically).
# In Docker this must stay inside the /app/data volume.
DATABASE_URL="file:./data/app.db"

# 32-byte hex key used to encrypt provider API keys at rest (AES-256-GCM).
# REQUIRED. Generate with: openssl rand -hex 32
# If this changes, previously stored keys cannot be decrypted — users must re-enter them.
ENCRYPTION_KEY=""

# Optional: pre-seed OpenRouter without using the Settings UI.
# The same key can also be added later via Settings -> Providers (recommended).
OPENROUTER_API_KEY=""

# Default OpenRouter model for LLM calls. Any valid OpenRouter model ID works.
OPENROUTER_MODEL="openrouter/free"

# --- Custom LLM (OpenAI-compatible): provider id "custom-llm" ---
# Point at OpenAI, Ollama, LM Studio, vLLM, or any OpenAI-compatible server.
# When this key is set (env or Settings UI) and the provider is active,
# it becomes the primary AI provider for the pipeline.
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_BASE_URL="https://api.openai.com/v1"
CUSTOM_LLM_MODEL="llama3.1"

# --- Phase 4: video generation (honest stub — not implemented yet) ---
# Kling needs JWT auth and Runway is async task-based; both need a job
# queue before they can be wired safely. Leave unset for now.
VIDEO_PROVIDER_API_KEY=""

# --- Phase 5: text-to-speech (OpenAI TTS, provider id "tts") ---
# POST {base}/audio/speech; OPENAI_API_KEY is accepted as an alias.
TTS_PROVIDER_API_KEY=""
# Optional overrides (defaults: https://api.openai.com/v1, tts-1, alloy).
TTS_BASE_URL=""
TTS_MODEL=""
TTS_VOICE=""

# --- Phase 5: web search (Tavily, provider id "search") ---
SEARCH_PROVIDER_API_KEY=""
# TAVILY_API_KEY is accepted as an alias.
TAVILY_API_KEY=""

# Directory for generated TTS audio (server-local). Defaults to ./data/audio.
AUDIO_OUTPUT_DIR=""

# Asset storage root (Phase 3). Uploaded media lives under
# <ASSET_DIR>/<projectId>/ and renders under <ASSET_DIR>/<projectId>/exports/.
ASSET_DIR="./data/assets"
